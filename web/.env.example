# Copy this file to web/.env when real API credentials are available.
# NAVER_CLIENT_ID / SECRET: NAVER API HUB local search application keys.
# NAVER_MAP_API_KEY_ID / KEY: NAVER Cloud Maps application keys.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_MAP_API_KEY_ID=
NAVER_MAP_API_KEY=
TOUR_API_SERVICE_KEY=
# Optional: HTTPS endpoint for an official partner product feed.
# Each item should include title, price, provider, and optionally affiliate_url/image.
TRAVEL_PARTNER_FEED_URL=
PARTNER_FEED_ALLOWED_HOSTS=
# Optional provider-specific official feeds. Keep credentials server-side.
MYREALTRIP_API_URL=
MYREALTRIP_API_KEY=
KLOOK_API_URL=
KLOOK_API_KEY=
PARTNER_TIMEOUT_MS=8000
# Local safety caps; repeated searches are cached before a new request is sent.
NAVER_DAILY_LIMIT=500
TOUR_DAILY_LIMIT=100
MAP_DAILY_LIMIT=100
PARTNER_DAILY_LIMIT=30
API_CACHE_TTL_SECONDS=600
WEB_PORT=8765
# 0.0.0.0 allows phones on the same Wi-Fi to open the service.
WEB_HOST=0.0.0.0
