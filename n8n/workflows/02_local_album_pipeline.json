{
  "name": "Suno - Reviewed Album to Private YouTube",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-pipeline",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "command": "cd /workspace && python3 -m budget.suno_pipeline --input /workspace/downloads/suno --output /workspace/outputs/albums --metadata-defaults /workspace/config/suno_automation_defaults.json --preflight --non-interactive --build --render-video --upload-youtube --report /workspace/outputs/albums/automation-report.json"
      },
      "id": "run-local-pipeline",
      "name": "Run Reviewed Local Pipeline",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [300, 300]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Run Reviewed Local Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "suno-local-album-youtube-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {}
}
