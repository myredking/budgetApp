# 이 파일을 .env.n8n으로 복사한 뒤 값을 확인하세요.
# .env.n8n은 비밀값이므로 Git에 커밋하지 않습니다.

# 재현 가능한 운영을 위해 실제 사용 버전 태그를 반드시 고정하세요.
N8N_IMAGE_TAG=replace-with-pinned-n8n-version

# 32자 이상의 예측 불가능한 문자열로 교체하세요.
N8N_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# 로컬 전용 접속 설정입니다.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

GENERIC_TIMEZONE=Asia/Seoul
TZ=Asia/Seoul

# 오래된 실행 이력을 자동 정리합니다.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
