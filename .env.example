# Suno-compatible provider credentials and endpoint.
SUNO_API_KEY=replace-me
SUNO_API_BASE_URL=https://api.sunoapi.org/api/v1
# Optional. Set this only when your provider requires a callback URL.
SUNO_CALLBACK_URL=
SUNO_MONTHLY_DOWNLOAD_LIMIT=20
# Suno billing reset day (1-31). Set your actual subscription renewal day.
SUNO_BILLING_DAY=1
SUNO_QUOTA_STATE_FILE=.state/suno.downloads.json

# Google Sheets service-account access.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SPREADSHEET_ID=replace-me
GOOGLE_SHEET_NAME=Tracks

# YouTube Data API OAuth files. Uploads default to private and require manual publish.
YOUTUBE_CLIENT_SECRETS_FILE=secrets/youtube-client.json
YOUTUBE_TOKEN_FILE=.state/youtube-token.json
YOUTUBE_UPLOAD_STATE_FILE=.state/youtube-uploads.json
